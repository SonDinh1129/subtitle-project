# ══════════════════════════════════════════════
# SubAI — Environment Variables
# ══════════════════════════════════════════════
# Copy this file to .env and fill in your values.
# .env is gitignored — never commit real secrets.
# ══════════════════════════════════════════════

# ─── Flask Backend ────────────────────────────
SECRET_KEY=your-flask-secret-key-change-in-prod
FLASK_DEBUG=false
PORT=5000

# ─── Supabase (Backend — service role) ────────
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
SUPABASE_JWT_SECRET=your-jwt-secret-from-supabase-dashboard

# ─── MoMo ─────────────────────────────────────
MOMO_PARTNER_CODE=MOMO_ATM_DEV
MOMO_ACCESS_KEY=your-momo-access-key
MOMO_SECRET_KEY=your-momo-secret-key
MOMO_ENDPOINT=https://test-payment.momo.vn/v2/gateway/api/create
# ngrok tunnel URL — MoMo IPN cannot reach localhost directly
NGROK_URL=https://xxxx-xx-xxx-xxx-xx.ngrok-free.app

# ─── Colab ────────────────────────────────────
COLAB_URL=https://xxxx-xx-xxx-xxx-xx.ngrok-free.app

# ─── CORS ─────────────────────────────────────
FRONTEND_URL=http://localhost:5173

# ─── Frontend (Vite) ──────────────────────────
# These go in .env.local for frontend dev, or in your build env
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key
VITE_API_URL=http://localhost:5000/api

# ─── OpenAI (Translation Quality Evaluation) ─
# Required for GET /api/jobs/<id>/translation-quality
OPENAI_API_KEY=

# ─── Rate Limiting (Redis) ────────────────────
# Optional: Redis URL for rate limiter shared across gunicorn workers.
# Without this, each worker has its own counter (limits multiply by worker count).
# Example: redis://localhost:6379/0
REDIS_URL=
